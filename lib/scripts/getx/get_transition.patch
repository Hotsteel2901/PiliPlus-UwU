+/// Signature of a route transition builder supplied by the host application.
+typedef GetNativeTransitionBuilder =
+    Widget Function(
+      PageRoute<dynamic> route,
+      BuildContext context,
+      Animation<double> animation,
+      Animation<double> secondaryAnimation,
+      Widget child,
+    );
+
+/// Host application hook that replaces the stock page transition used by the
+/// [Transition.native] (Android/desktop) branch of [GetPageRouteTransitionMixin].
+///
+/// GetX routes do not expose per-route transition builders, so this small,
+/// optional indirection lets an application install its own Material 3
+/// Expressive, predictive-back aware transition without forking every route.
+/// When none of these members are set the stock behaviour is kept untouched.
+abstract final class GetNativeTransition {
+  /// Replaces `PredictiveBackPageTransitionsBuilder` on non Apple platforms.
+  static GetNativeTransitionBuilder? builder;
+
+  /// Transition delegated to the route below a native transition, which also
+  /// enables the outgoing route to animate while the incoming one plays.
+  static DelegatedTransitionBuilder? delegatedTransition;
+
+  /// Per route duration override.
+  static Duration? Function(PageRoute<dynamic> route)? duration;
+}
+
