diff --git a/lib/src/m3e_glass.dart b/lib/src/m3e_glass.dart
new file mode 100644
index 0000000..67f598b
--- /dev/null
+++ b/lib/src/m3e_glass.dart
@@ -0,0 +1,164 @@
+// Copyright 2014 The Flutter Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+import 'dart:ui' show ImageFilter;
+
+import 'package:flutter/widgets.dart';
+
+import 'colors.dart';
+import 'theme.dart';
+
+/// Application wide configuration for the Material 3 Expressive glass surfaces
+/// painted by this package (app bars, dialogs, sheets...).
+///
+/// It lives next to [Theme] so the package's components can render frosted
+/// surfaces without depending on the host application. When no scope is
+/// installed, every surface keeps its stock, opaque rendering.
+class M3EGlassScope extends InheritedWidget {
+  /// Installs a glass configuration for the subtree.
+  const M3EGlassScope({
+    super.key,
+    required this.enabled,
+    this.appBar = true,
+    this.overlay = true,
+    this.blur = 28,
+    this.tint,
+    this.tintOpacity = 0.55,
+    this.highlight = true,
+    required super.child,
+  });
+
+  /// Whether glass may be painted at all.
+  final bool enabled;
+
+  /// Whether app bars paint a frosted background.
+  final bool appBar;
+
+  /// Whether dialogs and bottom sheets paint a frosted surface.
+  final bool overlay;
+
+  /// Peak blur radius in logical pixels.
+  final double blur;
+
+  /// Base tint; defaults to `surfaceContainerHigh` of the current theme.
+  final Color? tint;
+
+  /// Tint opacity applied over the blur.
+  final double tintOpacity;
+
+  /// Paints a soft specular highlight over the surface.
+  final bool highlight;
+
+  static M3EGlassScope? maybeOf(BuildContext context) =>
+      context.dependOnInheritedWidgetOfExactType<M3EGlassScope>();
+
+  @override
+  bool updateShouldNotify(M3EGlassScope oldWidget) =>
+      enabled != oldWidget.enabled ||
+      appBar != oldWidget.appBar ||
+      overlay != oldWidget.overlay ||
+      blur != oldWidget.blur ||
+      tint != oldWidget.tint ||
+      tintOpacity != oldWidget.tintOpacity ||
+      highlight != oldWidget.highlight;
+}
+
+/// A frosted surface: blurs whatever is painted behind it, tints it with the
+/// current surface tone and adds a soft highlight, following [shape].
+///
+/// Degrades to its child untouched when no enabled [M3EGlassScope] is in scope,
+/// so contrast never breaks.
+class M3EGlassSurface extends StatelessWidget {
+  /// Wraps [child] in a frosted, backdrop-blurred surface.
+  const M3EGlassSurface({
+    super.key,
+    required this.child,
+    this.shape,
+    this.blur,
+    this.tint,
+    this.tintOpacity,
+  });
+
+  final Widget child;
+  final ShapeBorder? shape;
+  final double? blur;
+  final Color? tint;
+  final double? tintOpacity;
+
+  @override
+  Widget build(BuildContext context) {
+    final scope = M3EGlassScope.maybeOf(context);
+    if (scope == null || !scope.enabled) {
+      return child;
+    }
+    final theme = Theme.of(context);
+    final isDark = theme.brightness == Brightness.dark;
+    final surfaceShape = shape ?? const RoundedRectangleBorder();
+    final sigma = blur ?? scope.blur;
+    final base = tint ?? scope.tint ?? theme.colorScheme.surfaceContainerHigh;
+
+    // A backdrop blur inside a route that is being translated or scaled has to
+    // re-render the backdrop every frame, which is very expensive on Skia. Fall
+    // back to an opaque tint for the duration of a page transition.
+    if (_isRouteTransitionActive(context)) {
+      return ClipPath(
+        clipper: ShapeBorderClipper(shape: surfaceShape),
+        child: ColoredBox(color: base, child: child),
+      );
+    }
+
+    final tintColor = base.withValues(alpha: tintOpacity ?? scope.tintOpacity);
+    final highlightBase = isDark ? Colors.white : Colors.white;
+
+    return Stack(
+      fit: StackFit.passthrough,
+      children: <Widget>[
+        Positioned.fill(
+          child: ClipPath(
+            clipper: ShapeBorderClipper(shape: surfaceShape),
+            child: BackdropFilter(
+              filter: ImageFilter.blur(
+                sigmaX: sigma,
+                sigmaY: sigma,
+                tileMode: TileMode.mirror,
+              ),
+              child: ColoredBox(
+                color: tintColor,
+                child: const SizedBox.expand(),
+              ),
+            ),
+          ),
+        ),
+        if (scope.highlight)
+          Positioned.fill(
+            child: IgnorePointer(
+              child: DecoratedBox(
+                decoration: ShapeDecoration(
+                  shape: surfaceShape,
+                  gradient: LinearGradient(
+                    begin: Alignment.topLeft,
+                    end: Alignment.bottomRight,
+                    colors: <Color>[
+                      highlightBase.withValues(alpha: isDark ? 0.06 : 0.24),
+                      highlightBase.withValues(alpha: 0.0),
+                    ],
+                  ),
+                ),
+              ),
+            ),
+          ),
+        child,
+      ],
+    );
+  }
+}
+
+/// Whether the route owning [context] is currently animating a page transition.
+bool _isRouteTransitionActive(BuildContext context) {
+  final route = ModalRoute.of(context);
+  final animation = route?.animation;
+  final secondary = route?.secondaryAnimation;
+  return (animation?.isAnimating ?? false) ||
+      (secondary?.isAnimating ?? false);
+}
